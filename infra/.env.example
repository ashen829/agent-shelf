# Copy to infra/.env and fill in. Never commit .env.
# Docker Compose reads it, and the backend imports it in the `local` profile.
POSTGRES_DB=agentshelf
POSTGRES_USER=agentshelf
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Claude key for AI cleanup (M2). Never set ANTHROPIC_API_KEY.
AGENTSHELF_CLAUDE_KEY=
