{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Dashboard API for suppliers. Errors use RFC 9457 problem details.",
    "title" : "AgentShelf API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "description" : "Supplier sign-up, login and the current account",
    "name" : "Auth"
  } ],
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccountResponse"
                }
              }
            },
            "description" : "Signed in"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid fields"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Email or password is incorrect"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Missing or invalid CSRF token"
          }
        },
        "summary" : "Sign in with email and password",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "Signed out (also when not signed in)"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Missing or invalid CSRF token"
          }
        },
        "summary" : "Sign out and end the session",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccountResponse"
                }
              }
            },
            "description" : "The current account"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Not signed in"
          }
        },
        "summary" : "The signed-in user and their supplier",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/signup" : {
      "post" : {
        "operationId" : "signup",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignupRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccountResponse"
                }
              }
            },
            "description" : "Account created and signed in"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid fields"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Missing or invalid CSRF token"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Email already registered"
          }
        },
        "summary" : "Create a supplier account and its owner, and sign in",
        "tags" : [ "Auth" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AccountResponse" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "OWNER", "STAFF" ]
          },
          "supplier" : {
            "$ref" : "#/components/schemas/SupplierResponse"
          },
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "email", "role", "supplier", "userId" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      },
      "SignupRequest" : {
        "type" : "object",
        "properties" : {
          "companyName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 2
          },
          "currency" : {
            "type" : "string",
            "minLength" : 1
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 12
          }
        },
        "required" : [ "companyName", "currency", "email", "password" ]
      },
      "SupplierResponse" : {
        "type" : "object",
        "properties" : {
          "currency" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "currency", "id", "name", "slug" ]
      }
    }
  }
}
